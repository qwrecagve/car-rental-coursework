# Avtomobil Ijarasi loyihasi uchun yashirin muhit o'zgaruvchilari (Environment Variables)

# Server qaysi portda ishlashi kerak
PORT=8000

# Dastur hozir qaysi holatda ishlashi (masalan: development, production)
ENVIRONMENT=development

# Agar keyinchalik haqiqiy ma'lumotlar bazasi (masalan: PostgreSQL yoki MySQL) ulasangiz, uning manzili shu yerga yoziladi
# DATABASE_URL=sqlite:///./car_rental.db
